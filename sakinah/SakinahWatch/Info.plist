<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Sakīnah</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Sakīnah reads heart rate and HRV to suggest a moment of dhikr when signs of stress appear.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>During automatic salah tracking, Sakīnah runs a quiet workout session so your watch stays awake. It does not save workouts.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sakīnah uses your location to compute prayer times and find nearby mosques.</string>
	<key>NSMotionUsageDescription</key>
	<string>Sakīnah uses motion to recognize wudu steps and salah postures (qiyam, ruku, sujood) so it can gently track your rakʿāt.</string>
	<key>WKApplication</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
		<string>location</string>
	</array>
	<key>WKWatchOnly</key>
	<true/>
</dict>
</plist>
